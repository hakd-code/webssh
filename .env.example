# ===== WebSSH 平台环境变量示例 =====
# 首次启动时若不存在 .env 会自动从本文件复制生成

# 服务监听端口(单端口同时托管 API + WebSocket + 前端构建产物)
PORT=3112

# JWT 签名密钥(必改!)。生成方式:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=6f1c9d7e2a4b8c3d5e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b

# 凭据加密密钥(必改!):AES-256-GCM,必须为 32 字节 = 64 个十六进制字符。
# 生成方式:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   或 openssl rand -hex 32
# 注意:更换密钥后,数据库中已加密的历史凭据将无法解密,请务必备份此密钥。
ENCRYPTION_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90

# 站点对外访问地址(用于拼接密码重置邮件中的链接)。
# 留空时自动使用请求的 Origin。
APP_URL=

# 日志级别:trace | debug | info | warn | error
LOG_LEVEL=info

# 运行环境:production 时 Express 托管 dist/ 静态资源
NODE_ENV=
